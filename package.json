{
  "name": "macpip",
  "productName": "MacPiP",
  "version": "1.0.0",
  "description": "Picture-in-picture for Mac: a floating, always-on-top window",
  "author": "Anish Yadav",
  "contributors": ["Gaurav Dadhich (original YT Float)"],
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visy-ani/MacPiP.git"
  },
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "build": "electron-builder --mac dir",
    "build:universal": "electron-builder --mac dir --universal",
    "make-launcher": "bash scripts/make-dev-launcher.sh",
    "install-app": "bash scripts/install-app.sh"
  },
  "build": {
    "appId": "dev.visyani.macpip",
    "productName": "MacPiP",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.video",
      "identity": null,
      "icon": "build/icon.png"
    },
    "afterSign": "build/adhoc-sign.js",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
